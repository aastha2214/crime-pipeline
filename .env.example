# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Socrata app token (https://data.cambridgema.gov/profile/edit/developer_settings)
SOCRATA_APP_TOKEN=your_socrata_app_token_here

# Postgres for the crime data (docker-compose service postgres_cpd)
POSTGRES_USER=cpd_user
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=cpd_db

# pgAdmin login
PGADMIN_DEFAULT_EMAIL=you@example.com
PGADMIN_DEFAULT_PASSWORD=change_me

# Postgres that stores Metabase's own metadata (service postgres_mb)
METABASE_DB_USER=metabase
METABASE_DB_PASSWORD=change_me

# Metabase admin account created by scripts/setup_metabase.py
METABASE_URL=http://localhost:3000
METABASE_ADMIN_EMAIL=you@example.com
METABASE_ADMIN_PASSWORD=change_me_to_a_long_password

# Optional safety valve: abort a run if it would flag more than this fraction of
# active rows as deleted (guards against the API returning a truncated id list)
MAX_DELETE_FRACTION=0.5

# --- Optional ---
# Daily schedule (cron syntax) and its timezone. Default: midnight US Eastern.
# ETL_CRON=0 0 * * *
# ETL_TIMEZONE=America/New_York
#
# NOTE for Docker/cloud: you do not need to change POSTGRES_HOST / POSTGRES_PORT / METABASE_URL here.
# docker-compose.yml overrides them for the pipeline container (host = postgres_cpd, port = 5432).

# Optional PUBLIC link: a domain that points at this server (e.g. 1-2-3-4.sslip.io for server IP 1.2.3.4).
# When set, deploy.sh also starts the Caddy HTTPS proxy on ports 80/443. See DEPLOY_CLOUD.md ("Public view-only link").
# SITE_DOMAIN=
